{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onamea-api",
  "main": "app.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "OPERATION_STORE",
        "class_name": "OperationStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OperationStore"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ONAMEA_KV",
      "id": "203d5ddf319e411d9796042ac6d64210"
    }
  ]
}
