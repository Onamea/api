{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "OPERATION_STORE",
        "class_name": "OperationStoreV2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OperationStore"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OperationStoreV2"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["OperationStore"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ONAMEA_KV",
      "id": "203d5ddf319e411d9796042ac6d64210"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
