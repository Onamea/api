{
  "name": "@onamea/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "seed:dev": "node scripts/seed.ts",
    "deploy": "wrangler deploy",
    "deploy:acceptance": "wrangler deploy --env acceptance",
    "test": "node --test test/",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clear:dev": "rm -rf .wrangler/state/*"
  },
  "dependencies": {
    "@onamea/crdt": "0.6.7",
    "@onamea/types": "0.5.4",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.163.0"
  },
  "packageManager": "pnpm@12.16.1"
}
